{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pepperdash.com/schemas/epi-wyrestorm-networkHD/nhd-ctl-pro.schema.json",
  "title": "nhd-ctl-pro",
  "description": "Device config entry for a device of type \"nhd-ctl-pro\". Properties object for a device of type \"nhd-ctl-pro\" (also \"nhdctlpro\") - the WyreStorm NetworkHD controller (out-of-band Telnet control-plane device) - backed by NhdDeviceProperties (NhdDeviceProperties.cs). This class is shared by all NHD device roles (controller, Tx, Rx); fields most relevant to the controller are apiUsername/apiPassword and customMultiviewLayouts/multiviewPresets (which define named layouts usable by any decoder).",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique identifier for this device within the configuration file."
    },
    "name": {
      "type": "string",
      "description": "Friendly display name for this device."
    },
    "type": {
      "const": "nhd-ctl-pro",
      "description": "Discriminator identifying the plugin factory that instantiates this device."
    },
    "properties": {
      "$ref": "#/$defs/properties",
      "description": "Properties object for a device of type \"nhd-ctl-pro\" (also \"nhdctlpro\") - the WyreStorm NetworkHD controller (out-of-band Telnet control-plane device) - backed by NhdDeviceProperties (NhdDeviceProperties.cs). This class is shared by all NHD device roles (controller, Tx, Rx); fields most relevant to the controller are apiUsername/apiPassword and customMultiviewLayouts/multiviewPresets (which define named layouts usable by any decoder)."
    }
  },
  "required": [
    "key",
    "name",
    "type",
    "properties"
  ],
  "$defs": {
    "properties": {
      "type": "object",
      "properties": {
        "control": {
          "$ref": "#/$defs/control"
        },
        "matrixInputSlot": {
          "type": "integer",
          "description": "Not typically used for the controller role."
        },
        "matrixOutputSlot": {
          "type": "integer",
          "description": "Not typically used for the controller role."
        },
        "alias": {
          "type": "string",
          "description": "Not typically used for the controller role."
        },
        "rs232": {
          "$ref": "#/$defs/rs232"
        },
        "apiUsername": {
          "type": "string",
          "description": "Username for the NHD-CTL HTTP API."
        },
        "apiPassword": {
          "type": "string",
          "description": "Password for the NHD-CTL HTTP API."
        },
        "mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Transmitter",
            "Receiver",
            "Transceiver",
            null
          ],
          "description": "Not typically used for the controller role."
        },
        "customMultiviewLayouts": {
          "type": "array",
          "description": "Named custom multiview geometry profiles usable by decoders in this system.",
          "items": {
            "$ref": "#/$defs/customMultiviewLayout"
          }
        },
        "multiviewPresets": {
          "type": "array",
          "description": "Named multiview presets (either a controller scene name or a config-defined custom layout) plus optional window-to-TX routing.",
          "items": {
            "$ref": "#/$defs/multiviewPreset"
          }
        },
        "maxTileCount": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Not applicable to the controller role."
        }
      },
      "required": [
        "control"
      ]
    },
    "control": {
      "type": "object",
      "description": "Standard Essentials communication control block. Typically method \"TcpIp\" (Telnet, port 23).",
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^(?:[nN][oO][nN][eE]|[cC][oO][mM]|[iI][pP][iI][dD]|[iI][pP][iI][dD][tT][cC][pP]|[iI][rR]|[sS][sS][hH]|[tT][cC][pP][iI][pP]|[tT][eE][lL][nN][eE][tT]|[cC][rR][eE][sS][nN][eE][tT]|[cC][eE][cC]|[uU][dD][pP]|[hH][tT][tT][pP]|[hH][tT][tT][pP][sS]|[wW][sS]|[wW][sS][sS]|[sS][eE][cC][uU][rR][eE][tT][cC][pP][iI][pP]|[cC][oO][mM][bB][rR][iI][dD][gG][eE]|[iI][nN][fF][iI][nN][eE][tT][eE][xX])(?:\\s*,\\s*(?:[nN][oO][nN][eE]|[cC][oO][mM]|[iI][pP][iI][dD]|[iI][pP][iI][dD][tT][cC][pP]|[iI][rR]|[sS][sS][hH]|[tT][cC][pP][iI][pP]|[tT][eE][lL][nN][eE][tT]|[cC][rR][eE][sS][nN][eE][tT]|[cC][eE][cC]|[uU][dD][pP]|[hH][tT][tT][pP]|[hH][tT][tT][pP][sS]|[wW][sS]|[wW][sS][sS]|[sS][eE][cC][uU][rR][eE][tT][cC][pP][iI][pP]|[cC][oO][mM][bB][rR][iI][dD][gG][eE]|[iI][nN][fF][iI][nN][eE][tT][eE][xX]))*$",
          "description": "Case-insensitive."
        },
        "tcpSshProperties": {
          "$ref": "#/$defs/tcpSshProperties"
        }
      },
      "required": [
        "method",
        "tcpSshProperties"
      ]
    },
    "tcpSshProperties": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "default": 23
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "autoReconnect": {
          "type": "boolean",
          "default": true
        },
        "autoReconnectIntervalMs": {
          "type": "integer",
          "default": 5000
        }
      },
      "required": [
        "address",
        "port"
      ]
    },
    "rs232": {
      "type": "object",
      "description": "RS-232 pass-through settings for this NHD unit.",
      "properties": {
        "baudRate": {
          "type": "integer",
          "enum": [
            2400,
            4800,
            9600,
            19200,
            38400,
            57600,
            115200
          ],
          "default": 9600
        },
        "dataBits": {
          "type": "string",
          "default": "Eight",
          "pattern": "^(?:[sS][iI][xX]|[sS][eE][vV][eE][nN]|[eE][iI][gG][hH][tT])(?:\\s*,\\s*(?:[sS][iI][xX]|[sS][eE][vV][eE][nN]|[eE][iI][gG][hH][tT]))*$",
          "description": "Case-insensitive."
        },
        "parity": {
          "type": "string",
          "default": "None",
          "pattern": "^(?:[nN][oO][nN][eE]|[oO][dD][dD]|[eE][vV][eE][nN])(?:\\s*,\\s*(?:[nN][oO][nN][eE]|[oO][dD][dD]|[eE][vV][eE][nN]))*$",
          "description": "Case-insensitive."
        },
        "stopBits": {
          "type": "string",
          "default": "One",
          "pattern": "^(?:[oO][nN][eE]|[tT][wW][oO])(?:\\s*,\\s*(?:[oO][nN][eE]|[tT][wW][oO]))*$",
          "description": "Case-insensitive."
        },
        "appendCr": {
          "type": "boolean"
        },
        "appendLf": {
          "type": "boolean"
        },
        "sendAsHex": {
          "type": "boolean"
        }
      }
    },
    "customMultiviewLayout": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Unique layout key used by client code to select this geometry profile."
        },
        "displayName": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "default": "Tile",
          "pattern": "^(?:[tT][iI][lL][eE]|[oO][vV][eE][rR][lL][aA][yY])(?:\\s*,\\s*(?:[tT][iI][lL][eE]|[oO][vV][eE][rR][lL][aA][yY]))*$",
          "description": "Case-insensitive."
        },
        "canvasWidth": {
          "type": "integer",
          "default": 1920
        },
        "canvasHeight": {
          "type": "integer",
          "default": 1080
        },
        "audioMode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Unknown",
            "Window",
            "Separate",
            "NoChange",
            null
          ]
        },
        "audioWindowReference": {
          "type": [
            "integer",
            "null"
          ]
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/customMultiviewWindow"
          }
        }
      },
      "required": [
        "key"
      ]
    },
    "customMultiviewWindow": {
      "type": "object",
      "properties": {
        "windowReference": {
          "type": "integer",
          "description": "1-based window reference used to order or map this window in commands."
        },
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "scale": {
          "type": "string",
          "default": "Stretch",
          "pattern": "^(?:[fF][iI][tT]|[sS][tT][rR][eE][tT][cC][hH])(?:\\s*,\\s*(?:[fF][iI][tT]|[sS][tT][rR][eE][tT][cC][hH]))*$",
          "description": "Case-insensitive."
        },
        "rotation": {
          "type": [
            "integer",
            "null"
          ],
          "description": "e.g. 0, 90, 180, 270 when supported by firmware."
        }
      },
      "required": [
        "windowReference"
      ]
    },
    "multiviewPreset": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Unique preset key selected by control logic."
        },
        "displayName": {
          "type": "string"
        },
        "layoutSource": {
          "type": "string",
          "default": "Config",
          "pattern": "^(?:[cC][oO][nN][tT][rR][oO][lL][lL][eE][rR]|[cC][oO][nN][fF][iI][gG])(?:\\s*,\\s*(?:[cC][oO][nN][tT][rR][oO][lL][lL][eE][rR]|[cC][oO][nN][fF][iI][gG]))*$",
          "description": "Case-insensitive."
        },
        "layout": {
          "type": "string",
          "description": "Controller: CTL preset scene name (e.g. \"4-4\"). Config: key from customMultiviewLayouts."
        },
        "windowRoutes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/multiviewPresetWindowRoute"
          }
        },
        "audioMode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Unknown",
            "Window",
            "Separate",
            "NoChange",
            null
          ],
          "default": "NoChange"
        },
        "audioWindowReference": {
          "type": [
            "integer",
            "null"
          ]
        },
        "audioTxKey": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "key"
      ]
    },
    "multiviewPresetWindowRoute": {
      "type": "object",
      "properties": {
        "windowReference": {
          "type": "integer",
          "description": "1-based multiview window/tile reference."
        },
        "txKey": {
          "type": "string",
          "description": "TX device key to route into windowReference."
        }
      },
      "required": [
        "windowReference",
        "txKey"
      ]
    }
  }
}
